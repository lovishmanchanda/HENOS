{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HENOS",
  "version": "0.1.0",
  "identifier": "dev.henos.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HENOS",
        "width": 900,
        "height": 680,
        "minWidth": 560,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "One Digital World",
    "longDescription": "HENOS brings your Mac, Windows PC and phone together: copy on one device, paste on another. End-to-end encrypted, no account, no server.",
    "category": "Utility",
    "license": "Apache-2.0",
    "homepage": "https://github.com/lovishmanchanda/HENOS",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
